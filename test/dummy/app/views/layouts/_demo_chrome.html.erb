<script>
  // chats decides own-vs-other bubbles client-side, in its own Stimulus
  // controller, so one broadcast renders for every subscriber. The dummy
  // pins no Stimulus, so the screenshots do the same comparison by hand:
  // same rule, six lines instead of a bundle.
  (function () {
    function alignOwnBubbles() {
      var thread = document.querySelector("[data-chats--thread-me-value]");
      if (!thread) return;
      var me = thread.getAttribute("data-chats--thread-me-value");
      document.querySelectorAll(".chats-message[data-sender-key]").forEach(function (bubble) {
        bubble.classList.toggle("chats-message--own", bubble.getAttribute("data-sender-key") === me);
      });
    }
    document.addEventListener("DOMContentLoaded", alignOwnBubbles);
    document.addEventListener("turbo:load", alignOwnBubbles);
  })();
</script>
