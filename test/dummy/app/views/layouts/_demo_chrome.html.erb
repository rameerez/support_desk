  body.pb-console > div:not(.pb-bar) { flex: 1 1 auto; width: 100%; }
  .pb-console h1 { letter-spacing: -0.03em; }

  /* The half of a utility framework that isn't utilities: Tailwind's
     preflight. Without it the console's <ul>s keep their bullets and their
     40px indent, which is enough to push the queue's right-hand column
     clean off the page. */
  .pb-console *, .pb-console *::before, .pb-console *::after { box-sizing: border-box; }
