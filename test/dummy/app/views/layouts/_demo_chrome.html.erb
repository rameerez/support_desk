<%# Demo-only chrome for the README screenshots.

    The gem ships semantic `support-desk-*` / `chats-*` classes and documents
    four CSS variables as the theming seam; the console's bundled views are
    written in Tailwind utilities that a real host's build already has. This
    partial is the HOST half of both contracts, wearing an invented food
    delivery brand (Pepperbox) so the screenshots show what a themed desk
    looks like rather than the unstyled default.

    Nothing here is part of the gem. `screenshots/capture.rb` drives it. %>
<style>
  html:root {
    /* Pepperbox — invented brand, not modelled on any real delivery app. */
    --pb-ink:        #1B1033;
    --pb-brand:      #6D28D9;
    --pb-brand-dark: #55199F;
    --pb-brand-soft: #F1EBFF;
    --pb-saffron:    #F5A623;
    --pb-saffron-soft: #FFF4E0;
    --pb-mint:       #0E9F6E;
    --pb-mint-soft:  #E3F7EF;
    --pb-chilli:     #D93838;
    --pb-chilli-soft:#FDECEC;
    --pb-line:       #E7E1F4;
    --pb-muted:      #6B6383;
    --pb-page:       #F6F3FC;

    /* The gem's documented theming seam: four variables and the desk is ours. */
    --chats-accent:          var(--pb-brand);
    --chats-accent-contrast: #FFFFFF;
    --chats-surface:         var(--pb-brand-soft);
    --chats-border:          var(--pb-line);
    --chats-text:            var(--pb-ink);
    --chats-text-muted:      var(--pb-muted);
    --chats-bubble-bg:       #FFFFFF;
    --chats-radius:          1.25rem;
    --chats-max-width:       none;

    --support-desk-accent:          var(--pb-brand);
    --support-desk-accent-contrast: #FFFFFF;
    --support-desk-surface:         var(--pb-brand-soft);
    --support-desk-border:          var(--pb-line);
    --support-desk-text:            var(--pb-ink);
    --support-desk-text-muted:      var(--pb-muted);
    --support-desk-card-bg:         #FFFFFF;
    --support-desk-radius:          1.25rem;
  }

  /* The gem hides things with the `hidden` attribute (chats' edit bar, its
     receipts) and counts on a UA rule an author `display:` beats. A host
     with any CSS framework ships this line; this dummy has to too. */
  [hidden] { display: none !important; }

  html, body { height: 100%; }
  body {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    color: var(--pb-ink);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }

  /* --- Brand bar ------------------------------------------------------- */

