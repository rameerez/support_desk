<!DOCTYPE html>
<html>
  <head>
    <title>Dummy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= action_cable_meta_tag %>
    <%# Turbo, for real: a <turbo-frame> is only a frame in a browser that
        has Turbo loaded, so the system tests need this to be testing
        anything at all. %>
    <%= javascript_importmap_tags %>
    <%# Where engine stylesheets land (support_desk_styles, and any host's own). %>
    <%= yield :head %>
  </head>
  <body class="<%= "pb-console" if request.path.start_with?("/admin/support", "/madmin/support_tickets") %>">
    <div class="pb-bar">
      <span class="pb-bar__mark" aria-hidden="true">P</span>
      <span class="pb-bar__word">pepper<em>box</em></span>
      <span class="pb-bar__tag"><%= request.path.start_with?("/admin/support", "/madmin/support_tickets") ? "Support desk" : "Food, fast" %></span>
    </div>
    <%= yield %>
    <%# Demo-only: the Pepperbox theme the README screenshots are taken in.
        LAST, after the yield, because chats 0.2.0 renders its own stylesheet
        <link> inline in the body — a host theme in <head> would lose to it on
        document order for every rule of equal specificity. %>
    <%= render "layouts/demo_chrome" %>

    <%# The launcher, the two ways a host renders it (the `launcher` cookie,
        set by the browser tests): in the messaging dock's tray, or on its
        own in a corner when there is no dock. Absent: no launcher at all. %>
    <% case cookies[:launcher] %>
    <% when "dock" %>
      <%= chats_dock do %>
        <%= support_launcher show_for: :everyone, help_url: "https://help.example.com" %>
      <% end %>
    <% when "standalone" %>
      <%= support_launcher show_for: :everyone, help_url: "https://help.example.com" %>
    <% end %>
  </body>
</html>
